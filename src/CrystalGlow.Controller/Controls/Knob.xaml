<UserControl x:Class="CrystalGlow.Controller.Controls.Knob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="56" Height="56">
    <Grid>
        <Image x:Name="KnobImage" Source="/Assets/Knob.png" Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5"
               Cursor="SizeNS"
               MouseLeftButtonDown="KnobImage_MouseLeftButtonDown"
               MouseMove="KnobImage_MouseMove"
               MouseLeftButtonUp="KnobImage_MouseLeftButtonUp">
            <Image.RenderTransform>
                <RotateTransform x:Name="KnobRotation" Angle="0"/>
            </Image.RenderTransform>
        </Image>
    </Grid>
</UserControl>
